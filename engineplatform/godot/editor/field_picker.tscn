[gd_scene format=3]

[node name="FieldPicker" type="NetcodeFieldPicker"]
title = "选择同步属性"
ok_button_text = "添加属性"

[node name="Columns" type="HSplitContainer" parent="."]

[node name="Nodes" type="VBoxContainer" parent="Columns"]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Columns/Nodes"]
text = "1　选择节点"

[node name="Tree" type="Tree" parent="Columns/Nodes"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="Properties" type="VBoxContainer" parent="Columns"]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Columns/Properties"]
text = "2　选择属性"

[node name="Filter" type="LineEdit" parent="Columns/Properties"]
unique_name_in_owner = true
placeholder_text = "搜索属性"

[node name="Fields" type="ItemList" parent="Columns/Properties"]
unique_name_in_owner = true
size_flags_vertical = 3

[connection signal="item_selected" from="Columns/Nodes/Tree" to="." method="_select_node"]
[connection signal="text_changed" from="Columns/Properties/Filter" to="." method="_show_fields" unbinds=1]
[connection signal="item_selected" from="Columns/Properties/Fields" to="." method="_on_field_selected"]
[connection signal="item_activated" from="Columns/Properties/Fields" to="." method="_accept" unbinds=1]
[connection signal="confirmed" from="." to="." method="_accept"]
[connection signal="canceled" from="." to="." method="queue_free"]
[connection signal="close_requested" from="." to="." method="queue_free"]
