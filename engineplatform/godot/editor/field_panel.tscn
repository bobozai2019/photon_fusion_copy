[gd_scene format=3]

[ext_resource type="Script" path="res://addons/netcode/editor/field_panel.gd" id="1"]

[node name="FieldPanel" type="VBoxContainer"]
script = ExtResource("1")

[node name="Choose" type="Button" parent="."]
size_flags_horizontal = 0
text = "添加同步属性…"

[node name="Scroll" type="ScrollContainer" parent="."]
size_flags_vertical = 3

[node name="Rows" type="GridContainer" parent="Scroll"]
size_flags_horizontal = 3
columns = 5

[node name="PropertyHeader" type="Label" parent="Scroll/Rows"]
text = "同步属性"

[node name="CapacityHeader" type="Label" parent="Scroll/Rows"]
text = "容量"

[node name="InterpolationHeader" type="Label" parent="Scroll/Rows"]
text = "插值"

[node name="WriteAccessHeader" type="Label" parent="Scroll/Rows"]
text = "客户端可写"

[node name="ActionsHeader" type="Label" parent="Scroll/Rows"]

[connection signal="pressed" from="Choose" to="." method="_open_picker"]
