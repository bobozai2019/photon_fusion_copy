@PACKAGE_INIT@
set(NetcodeCore_BUILD_ID "@CORE_ID@")
set(NetcodeCore_VERSION "@PROJECT_VERSION@")
if(MSVC AND NOT MSVC_TOOLSET_VERSION STREQUAL "@MSVC_TOOLSET_VERSION@")
    message(FATAL_ERROR "NetcodeCore requires MSVC toolset @MSVC_TOOLSET_VERSION@. Rebuild Core for the host toolchain.")
endif()
if(@NETCODE_STEAM@ AND NOT TARGET NetcodeSteamworks)
    find_library(NetcodeSteamworks_LIBRARY steam_api64 HINTS "${NETCODE_STEAMWORKS_ROOT}/redistributable_bin/win64" REQUIRED)
    add_library(NetcodeSteamworks UNKNOWN IMPORTED)
    set_target_properties(NetcodeSteamworks PROPERTIES IMPORTED_LOCATION "${NetcodeSteamworks_LIBRARY}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NetcodeCoreTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SdkBuildId.cmake")
check_required_components(NetcodeCore)
